{
  "platform": "aliyun",
  "name": "阿里云百炼",
  "description": "阿里云AI大模型服务平台",
  "icon": "/assets/aiplatform/aliyun.png",
  "enabled": true,
  "config": {
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
    "timeout": 20,
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "models": [
    {
      "id": "qwen3.5-plus",
      "name": "Qwen3.5-Plus",
      "description": "阿里云最新的通用大模型，支持多轮对话、内容创作、代码生成等功能",
      "enabled": true,
      "params": {
        "context_window": 128000,
        "temperature": 0.7,
        "top_p": 0.95,
        "max_tokens": 4096
      },
      "doc_url": "https://help.aliyun.com/zh/model-studio/developer-reference/qwen3-5-model-api-reference"
    },
    {
      "id": "qwen-turbo",
      "name": "Qwen Turbo（经济型）",
      "description": "用于摘要、意图识别、状态更新和格式修复等低成本任务",
      "enabled": true,
      "params": {"context_window": 1000000, "temperature": 0.2, "top_p": 0.8, "max_tokens": 2048}
    }
  ],
  "embedding": {
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings",
    "model": "text-embedding-v3",
    "dimensions": 1024
  },
  "small_models": {
    "intent_classification": {"id": "qwen-turbo", "name": "Qwen Turbo", "enabled": true},
    "state_update": {"id": "qwen-turbo", "name": "Qwen Turbo", "enabled": true},
    "summarization": {"id": "qwen-turbo", "name": "Qwen Turbo", "enabled": true},
    "schema_repair": {"id": "qwen-turbo", "name": "Qwen Turbo", "enabled": true}
  },
  "auth_method": "api_key",
  "version": "1.0.0"
}
