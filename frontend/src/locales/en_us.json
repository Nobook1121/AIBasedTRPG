  "patterns": [
    { "pattern": "^结果: (.+)$", "replace": "Result: {1}" },
    { "pattern": "^在线玩家 (\\d+)\\/(\\d+)$", "replace": "Online players {1}/{2}" },
    { "pattern": "^已耗时: (.+)秒(?: 消耗Token：(.+))?$", "replace": "Elapsed: {1}s{2}" },
    { "pattern": "^剩余 (.+)$", "replace": "Remaining {1}" },
    { "pattern": "^已加载 (.+) 名用户$", "replace": "Loaded {1} users" },
    { "pattern": "^已导入 (.+) 张角色卡$", "replace": "Imported {1} character sheets" },
    { "pattern": "^已记录 (.+) (damage|san) (.+)，原因：(.+)$", "replace": "Recorded {1} {2} {3}; reason: {4}" },
    { "pattern": "^消息发送过于频繁，请稍后再试（限制 (.+) 条\\/分钟）$", "replace": "Messages are being sent too quickly. Try again later (limit: {1}/minute)." },
    { "pattern": "^成功导入 (.+) 个剧本$", "replace": "Imported {1} scenarios" },
    { "pattern": "^在线玩家 (.+)$", "replace": "Online players {1}" },
    { "pattern": "^第 (.+) 个参数必须是 (.+)$", "replace": "Argument {1} must be {2}" },
    { "pattern": "^下一项：(.*)$", "replace": "Next: {1}" },
    { "pattern": "^触发器(.+)$", "replace": "Trigger {1}" },
    { "pattern": "^(.+) 配置$", "replace": "{1} Configuration" }
  ]
