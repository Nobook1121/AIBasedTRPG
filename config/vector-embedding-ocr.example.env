# Qdrant (local Docker Compose)
AI_TRPG_VECTOR_DB_URL=http://127.0.0.1:6333
AI_TRPG_VECTOR_DB_API_KEY=

# OpenAI-compatible embedding endpoint
AI_TRPG_EMBEDDING_BASE_URL=https://api.openai.com/v1/embeddings
AI_TRPG_EMBEDDING_API_KEY=
AI_TRPG_EMBEDDING_MODEL=text-embedding-3-small
AI_TRPG_EMBEDDING_DIMENSIONS=256

# Local PaddleOCR for scanned PDFs
AI_TRPG_OCR_ENABLED=1
AI_TRPG_OCR_LANG=ch
